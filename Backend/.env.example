# AWS integration is intentionally disabled during Milestone 1.
AUDITVISION_AWS_REGION=ap-south-1
AUDITVISION_ENABLE_AWS=false
# Set only after confirming Bedrock availability and model access.
AUDITVISION_BEDROCK_MODEL_ID=

# Local FastAPI server configuration. Comma-separate browser origins only.
AUDITVISION_API_HOST=127.0.0.1
AUDITVISION_API_PORT=8000
AUDITVISION_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Read-only saved-result artifact locations, relative to Backend.
AUDITVISION_SAMPLE_RESULTS_DIR=data/results/milestone-3-improved
AUDITVISION_SAMPLE_GROUND_TRUTH_PATH=Sample Docs/Infosys_AuditVision_Synthetic_Test_Dataset/Infosys_AuditVision_Synthetic_Ground_Truth.json

# Local uploaded-document processing limits, relative artifact root.
AUDITVISION_DOCUMENTS_DIR=data/documents
AUDITVISION_MAX_UPLOAD_BYTES=26214400
AUDITVISION_MAX_PAGE_COUNT=50
AUDITVISION_MAX_PAGES_PER_REQUEST=5

# JSON artifact storage. Local is the normal development default.
AUDITVISION_STORAGE_BACKEND=local
AUDITVISION_S3_BUCKET=your-auditvision-s3-bucket
AUDITVISION_S3_REGION=us-east-1
AUDITVISION_S3_DOCUMENTS_PREFIX=documents/
AUDITVISION_S3_DEMO_KEY=demo/default-dashboard.json
AUDITVISION_DEMO_ENTRIES_ENABLED=true
AWS_DEFAULT_REGION=us-east-1
# Optional asynchronous validation runs automatically after OpenCV publishes its artifacts. OpenCV remains authoritative.
AUDITVISION_AI_VALIDATION_ENABLED=true
AWS_BEARER_TOKEN_BEDROCK=
AUDITVISION_AI_MODEL=google.gemma-4-e2b
AUDITVISION_AI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1
AUDITVISION_AI_TIMEOUT_SECONDS=60
AUDITVISION_AI_MAX_CANDIDATES=20
