# AI credentials are backend-only. Never put a provider key in the frontend
# environment because Vite values can be bundled into public browser assets.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# Local FastAPI service. This value is safe to expose in a browser bundle.
VITE_API_BASE_URL="http://127.0.0.1:8000"
