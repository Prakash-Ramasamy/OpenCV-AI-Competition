{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAuditVisionObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME",
      "Condition": {"StringLike": {"s3:prefix": ["demo/*", "documents/*"]}}
    },
    {
      "Sid": "ReadDashboardAndDocumentJson",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/demo/default-dashboard.json",
        "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/documents/*"
      ]
    },
    {
      "Sid": "WriteDocumentJson",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/documents/*"
    }
  ]
}
